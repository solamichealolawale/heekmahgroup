# Fetch structured page content plus native WordPress Posts during static generation.
# Leave false until the plugin and both REST endpoints are verified.
NUXT_CMS_ENABLED=false

# Nuxt public runtime values use these names if a staging build needs different origins.
NUXT_PUBLIC_SITE_URL=https://heekmahgroup.com
NUXT_PUBLIC_WORDPRESS_URL=https://heekmahgroup.com
